ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here

# DEEPSEEK_API_KEY is the primary text-generation provider (classification +
# reply generation) — effectively required, not optional, since there's no
# manual on/off switch for it (see agent/api_client.py: generate_content_tracked()).
# GEMINI_API_KEY is optional but recommended: Gemini automatically covers text
# generation if DeepSeek has a transient failure (quota/timeout/connection) —
# no config needed for that, it just won't fail over without a key set.
# Retrieval embeddings run on a local model (agent/embeddings.py), not Gemini
# — GEMINI_API_KEY being unset no longer breaks retrieval, only failover.
DEEPSEEK_API_KEY=your-deepseek-key-here
GEMINI_API_KEY=your-gemini-key-here

# Optional. How often run_handler.py polls the inbox, in seconds. Lowered
# from an original default of 60s: with classify+reply already down to
# ~4s of actual processing (see the token/latency optimization work), the
# poll interval was the dominant term in a customer's end-to-end wait —
# up to 60s just sitting unpolled before processing even starts. Raise
# this if 15s turns out to be too aggressive for a given Gmail account.
POLL_INTERVAL_SECONDS=15

# Optional. Comma-separated sender patterns that skip processing entirely —
# no classify_intent() call, no RAG, no draft saved, just marked Seen.
# Entries ending in "@" match as a local-part prefix (e.g. "noreply@" matches
# any address starting with it); bare domains match exactly or as a
# subdomain. Deliberately sender-address-only, never subject/body content —
# see agent/email_handler.py:_is_automated_sender() for why. Defaults cover
# common bulk-mail conventions plus Google's own account-notification domain
# (confirmed hitting a real inbox during testing). Empty = no filtering.
AUTOMATED_SENDER_PATTERNS=noreply@,no-reply@,donotreply@,do-not-reply@,mailer-daemon@,postmaster@,accounts.google.com

# Auto-send: off by default. When true, emails meeting all thresholds below
# are sent immediately without human review — see agent/email_handler.py.
AUTO_SEND_ENABLED=false
AUTO_SEND_INTENTS=PRICING,MATERIAL,PROGRESS
AUTO_SEND_CONFIDENCE_THRESHOLD=0.9
# Deliberately well above rag_chain.py's kb_miss escalation boundary
# (sigmoid 0.5) — see agent/auto_send_rules.py for why 0.5 here would give
# zero real safety margin over "just barely didn't escalate".
AUTO_SEND_RETRIEVAL_THRESHOLD=0.75
# Circuit breaker: caps real auto-sends per rolling hour, regardless of how
# many emails qualify. Protects against a scoring bug causing a send burst.
AUTO_SEND_MAX_PER_HOUR=20
# Optional. Comma-separated emails and/or bare domains (e.g. "@vipclinic.com")
# that should never be auto-sent to regardless of confidence/score — a human
# always handles these personally. Empty = no exclusions.
AUTO_SEND_EXCLUDED_CLIENTS=

# Shadow mode needs no flag — it's always on. Every email gets a
# would_auto_send column in data/drafts.db recording whether it would have
# qualified, whether or not AUTO_SEND_ENABLED is true. Use this to build up
# calibration data (compare would_auto_send=1 rows against their real human
# outcome) before ever turning AUTO_SEND_ENABLED on.

# Optional. Slack Incoming Webhook — pushes alerts for IMAP/SMTP outages and
# auto-send circuit breaker trips, so you don't have to keep the Ops
# Dashboard open to notice. Edge-triggered (fires once per incident, not
# once per poll cycle) — see agent/alerts.py. Leave unset and alerting is a
# no-op; nothing else in the pipeline depends on it.
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url-here

# Used by scripts/archive_old_drafts.py (not run automatically — a periodic
# maintenance task, run by hand or via cron). Moves terminal-state drafts
# (everything except pending_review) older than this many days into
# drafts_archive, keeping the live table lean. pending_review rows are never
# archived regardless of age.
DRAFTS_ARCHIVE_AFTER_DAYS=90

# Off by default. When true, app.py never imports agent.email_handler (skips
# chromadb/sentence-transformers/langchain_*/google-genai/openai entirely)
# and the Approve/Edit&Approve buttons update status locally without really
# sending. Needs no other secrets — see the "Deployment" section in README.md.
DEMO_MODE=false

# pages/2_Live_Demo.py runs the REAL pipeline on visitor-pasted text — a
# public, unauthenticated page that triggers real paid API calls needs a
# cost/abuse ceiling. LIVE_DEMO_MAX_PER_HOUR is a global cap across all
# visitors combined (agent/db.py:count_recent_live_demo_runs());
# LIVE_DEMO_SESSION_MAX is a lighter per-browser-session cap on top of that.
LIVE_DEMO_MAX_PER_HOUR=30
LIVE_DEMO_SESSION_MAX=5

# Optional. Only meaningful when data/ and chroma_db/ need to live somewhere
# other than the project root — e.g. a Railway volume mount path for the
# Stage 2 real-backend deployment (see README.md), where it's the only way
# to keep both on the one persistent volume a Railway service gets. Unset
# locally and on the public demo deployment — both keep using the project
# root exactly as before this variable existed. See agent/paths.py.
PERSISTENT_DATA_DIR=