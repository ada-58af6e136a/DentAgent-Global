ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here

# Auto-send: off by default. When true, emails meeting all thresholds below
# are sent immediately without human review — see agent/email_handler.py.
AUTO_SEND_ENABLED=false
AUTO_SEND_INTENTS=PRICING,MATERIAL,PROGRESS
AUTO_SEND_CONFIDENCE_THRESHOLD=0.9
AUTO_SEND_RETRIEVAL_THRESHOLD=0.5
# Circuit breaker: caps real auto-sends per rolling hour, regardless of how
# many emails qualify. Protects against a scoring bug causing a send burst.
AUTO_SEND_MAX_PER_HOUR=20
# Optional. Comma-separated emails and/or bare domains (e.g. "@vipclinic.com")
# that should never be auto-sent to regardless of confidence/score — a human
# always handles these personally. Empty = no exclusions.
AUTO_SEND_EXCLUDED_CLIENTS=

# Shadow mode needs no flag — it's always on. Every email gets a
# would_auto_send column in data/drafts.db recording whether it would have
# qualified, whether or not AUTO_SEND_ENABLED is true. Use this to build up
# calibration data (compare would_auto_send=1 rows against their real human
# outcome) before ever turning AUTO_SEND_ENABLED on.

# Optional. Only used automatically when Gemini has a transient failure
# (quota exhausted / 503 / timeout) — no manual switch, nothing to configure
# beyond the key. Leave unset and failover simply never triggers.
# See agent/api_client.py: generate_content_tracked().
DEEPSEEK_API_KEY=your-deepseek-key-here

# Optional. Slack Incoming Webhook — pushes alerts for IMAP/SMTP outages and
# auto-send circuit breaker trips, so you don't have to keep the Ops
# Dashboard open to notice. Edge-triggered (fires once per incident, not
# once per poll cycle) — see agent/alerts.py. Leave unset and alerting is a
# no-op; nothing else in the pipeline depends on it.
SLACK_WEBHOOK_URL=your-slack-incoming-webhook-url-here

# Used by scripts/archive_old_drafts.py (not run automatically — a periodic
# maintenance task, run by hand or via cron). Moves terminal-state drafts
# (everything except pending_review) older than this many days into
# drafts_archive, keeping the live table lean. pending_review rows are never
# archived regardless of age.
DRAFTS_ARCHIVE_AFTER_DAYS=90

# Off by default. When true, app.py never imports agent.email_handler (skips
# chromadb/sentence-transformers/langchain_*/google-genai/openai entirely)
# and the Approve/Edit&Approve buttons update status locally without really
# sending. Needs no other secrets — see the "Deployment" section in README.md.
DEMO_MODE=false